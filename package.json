{
  "name": "@siftql/core",
  "version": "0.1.0",
  "description": "A complete, extensible Lucene-like query language: hand-written parser, serializer, and in-memory search engine with real chronological date/time support. Zero dependencies.",
  "keywords": [
    "lucene",
    "query",
    "query-language",
    "parser",
    "ast",
    "search",
    "filter",
    "lql",
    "elasticsearch",
    "in-memory-search",
    "typescript",
    "date",
    "datetime"
  ],
  "homepage": "https://github.com/Hussein-Abdallah/siftql#readme",
  "bugs": {
    "url": "https://github.com/Hussein-Abdallah/siftql/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hussein-Abdallah/siftql.git"
  },
  "license": "MIT",
  "author": "Hussein Abdallah <sain.abdallah@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage",
    "dev": "tsup --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build",
    "playground": "tsx playground.ts",
    "diff": "tsx scripts/regression-diff.ts",
    "mutants": "tsx scripts/mutation-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.23.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
